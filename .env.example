# Copy this file to .env and fill in your own values. Never commit .env.

# ── Required ──────────────────────────────────────────────────────
# Google AI Studio key used for summarization and extraction.
# Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_gemini_api_key_here

# ── Optional ──────────────────────────────────────────────────────
# Gemini model used for summaries. A fuller model gives richer output
# at higher cost. Examples: gemini-3.5-flash-lite, gemini-3.5-flash
GEMINI_MODEL=gemini-3.5-flash-lite

# Whisper model size: tiny | base | small | medium | large
# Larger is more accurate but slower and needs more memory/disk.
# Each size downloads once on first use (small is ~460 MB).
WHISPER_MODEL=base

# Reserved for a future translation/analysis path. Not currently used.
MISTRAL_API_KEY=your_mistral_api_key_here
