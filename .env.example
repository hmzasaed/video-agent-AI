# Copy this file to .env and fill in your own values. Never commit .env.

# ── Required ──────────────────────────────────────────────────────
# Google AI Studio key used for summaries, extraction, Q&A, the research
# agent, and web search. Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_gemini_api_key_here

# ── Models ────────────────────────────────────────────────────────
# Gemini model used for summaries, extraction, and single-video Q&A.
GEMINI_MODEL=gemini-3.5-flash-lite

# Model used by the research agent (tool use). If it is busy or out of
# quota, the agent falls back to GEMINI_MODEL automatically.
GEMINI_AGENT_MODEL=gemini-3.5-flash

# Who writes summaries: gemini (default) or mistral (needs MISTRAL_API_KEY).
SUMMARY_PROVIDER=gemini
MISTRAL_API_KEY=your_mistral_api_key_here
# MISTRAL_MODEL=mistral-small-latest

# Whisper model size: tiny | base | small | medium | large
# Larger is more accurate but slower and needs more memory/disk.
# Each size downloads once on first use (small is ~460 MB).
WHISPER_MODEL=base

# ── Research agent ────────────────────────────────────────────────
# Maximum tool calls the agent makes per answer.
AGENT_MAX_STEPS=6
# Allow Gemini's Google Search grounding. Users can still turn it off per chat.
# Grounding needs available quota on your Gemini key.
WEB_SEARCH_ENABLED=true

# ── Storage ───────────────────────────────────────────────────────
# SQLite database for analyses, workspaces, contacts, tasks, and emails.
# DB_PATH=data/app.db
# Q&A index. The embedding model (all-MiniLM-L6-v2, ONNX) runs locally
# and downloads once (~80 MB) to ~/.cache/chroma on first use.
# CHROMA_DIR=data/chroma
# RAG_TOP_K=6
# Largest recording that can be uploaded, in MB.
# MAX_UPLOAD_MB=2048

# ── Email (meeting tasks) ─────────────────────────────────────────
# Emails are only sent after you review and confirm each one in the app,
# and only to saved contacts. While EMAIL_DRY_RUN=true they are logged on
# the server instead of delivered.
EMAIL_DRY_RUN=true
# Gmail: turn on 2-Step Verification, create an App Password
# (Google Account → Security → App passwords) and use it below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM=you@example.com
